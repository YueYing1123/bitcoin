# ===========================================
# Ensemble ELS 配置文件示例
# ===========================================
# 请复制此文件为 .env 并放在项目根目录，然后填入实际配置

# -------------------------------------------
# 数据路径配置
# -------------------------------------------
EXCEL_PATH=比特币数据.xlsx
TEXT_DIR=金融课题研究案例-比特币/金融课题案例数据全文
OUTPUT_DIR=outputs

# -------------------------------------------
# 模型与运行配置
# -------------------------------------------
# 要使用的模型列表（逗号分隔）
MODELS=KIMI,DEEPSEEK,GLM,QWEN,DOUBAO

# 每个模型的运行次数（用于投票）
RUNS_PER_MODEL=10

# 模型温度参数
TEMPERATURE=0

# 请求超时时间（秒）
REQUEST_TIMEOUT=60

# 最大重试次数
MAX_RETRIES=12

# 重试退避基数
BACKOFF_BASE=1.5

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# -------------------------------------------
# 字段定义配置
# -------------------------------------------
# 字段定义文件路径（YAML格式）
EXTRACT_FIELDS_PATH=docs/fields.yaml

# 或者直接使用JSON字符串定义字段（如果不使用文件）
# EXTRACT_FIELDS_JSON=[{"target": "field1", "description": "描述1"}, ...]

# ===========================================
# 模型 API 配置
# ===========================================

# -------------------------------------------
# KIMI (Moonshot AI)
# -------------------------------------------
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_MODEL=kimi-k2-turbo-preview

# 速率限制与并发控制
# RPM: Requests Per Minute (每分钟请求数)
# TPM: Tokens Per Minute (每分钟令牌数)
# MAX_CONCURRENT: 该模型内部最大并发运行次数
# 设置为 0 表示不限制
KIMI_RPM=60
KIMI_TPM=30000
KIMI_MAX_CONCURRENT=5

# -------------------------------------------
# DEEPSEEK (通过火山方舟)
# -------------------------------------------
ARK_API_KEY=your_ark_api_key_here
DEEPSEEK_MODEL=deepseek-r1-250528

# 速率限制与并发控制
DEEPSEEK_RPM=60
DEEPSEEK_TPM=30000
DEEPSEEK_MAX_CONCURRENT=5

# -------------------------------------------
# DOUBAO (豆包，通过火山方舟)
# -------------------------------------------
# 注意: DOUBAO 使用与 DEEPSEEK 相同的 ARK_API_KEY
DOUBAO_MODEL=doubao-seed-1-6-251015

# 速率限制与并发控制
DOUBAO_RPM=60
DOUBAO_TPM=30000
DOUBAO_MAX_CONCURRENT=5

# -------------------------------------------
# QWEN (通义千问，阿里云)
# -------------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-max

# 速率限制与并发控制
QWEN_RPM=60
QWEN_TPM=30000
QWEN_MAX_CONCURRENT=5

# -------------------------------------------
# GLM (智谱AI)
# -------------------------------------------
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GLM_MODEL=glm-4.6

# 速率限制与并发控制
GLM_RPM=60
GLM_TPM=30000
GLM_MAX_CONCURRENT=5

# -------------------------------------------
# GEMINI (Google AI)
# -------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ===========================================
# 并发控制说明
# ===========================================
# 
# MAX_CONCURRENT 参数控制每个模型内部的最大并发运行次数
# 
# 1. 模型之间默认全部并发
#    - 5个模型会同时执行，互不影响
# 
# 2. 每个模型内部可以独立控制并发数
#    - 设置为 0：不限制，所有 runs 全部并发
#    - 设置为 N：最多同时执行 N 个 runs
#    - 例如：KIMI_MAX_CONCURRENT=5，RUNS_PER_MODEL=10
#      表示 KIMI 模型会分两批执行，每批5个并发
# 
# 3. 配置建议
#    - API 稳定性好：可设置为 0（全部并发）
#    - API 有限流：建议设置为 RPM/10 左右
#    - 内存受限：减小并发数以降低内存占用
#    - 例如：
#      * KIMI_RPM=60, KIMI_MAX_CONCURRENT=0  (不限制，最快)
#      * KIMI_RPM=60, KIMI_MAX_CONCURRENT=5  (适中)
#      * KIMI_RPM=10, KIMI_MAX_CONCURRENT=2  (保守)
# 
# 4. 示例场景
#    假设配置：RUNS_PER_MODEL=10
#    - KIMI_MAX_CONCURRENT=0：10个runs同时执行
#    - DEEPSEEK_MAX_CONCURRENT=5：10个runs分2批，每批5个
#    - QWEN_MAX_CONCURRENT=2：10个runs分5批，每批2个
#    这三个模型会同时开始，但内部并发数不同
# 
# ===========================================