# ===========================================
# Ensemble ELS 配置文件示例
# ===========================================
# 请复制此文件为 .env 并放在项目根目录，然后填入实际配置

# -------------------------------------------
# 数据路径配置
# -------------------------------------------
# 索引文件（JSON 格式）
INDEX_PATH=data/data-index.json
# 文本文件（JSON 格式）
TEXTS_PATH=data/data-texts.json
# 输出目录
OUTPUT_DIR=outputs

# -------------------------------------------
# 模型与运行配置
# -------------------------------------------
# 要使用的模型列表（逗号分隔，云端模式）
MODELS=KIMI,DEEPSEEK,GLM,QWEN,DOUBAO

# 每个模型的运行次数（用于投票）
RUNS_PER_MODEL=10

# 模型温度参数
TEMPERATURE=0

# 请求超时时间（秒）
REQUEST_TIMEOUT=120

# 最大重试次数
MAX_RETRIES=12

# 重试退避基数
BACKOFF_BASE=1.5

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# -------------------------------------------
# 字段定义配置
# -------------------------------------------
# 字段定义文件路径（YAML格式）
EXTRACT_FIELDS_PATH=docs/fields.yaml

# ===========================================
# 本地 vLLM 服务器配置
# ===========================================
# vLLM OpenAI 兼容 API 地址
VLLM_BASE_URL=http://localhost:8000/v1

# 模型名称（与 --served-model-name 对应）
VLLM_MODEL=qwen3-32b

# ===========================================
# 云端模型 API 配置（可选）
# ===========================================

# -------------------------------------------
# KIMI (Moonshot AI)
# -------------------------------------------
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_MODEL=kimi-k2-turbo-preview
KIMI_RPM=60
KIMI_TPM=30000
KIMI_MAX_CONCURRENT=5

# -------------------------------------------
# DEEPSEEK (通过火山方舟)
# -------------------------------------------
ARK_API_KEY=your_ark_api_key_here
DEEPSEEK_MODEL=deepseek-r1-250528
DEEPSEEK_RPM=60
DEEPSEEK_TPM=30000
DEEPSEEK_MAX_CONCURRENT=5

# -------------------------------------------
# DOUBAO (豆包，通过火山方舟)
# -------------------------------------------
DOUBAO_MODEL=doubao-seed-1-6-251015
DOUBAO_RPM=60
DOUBAO_TPM=30000
DOUBAO_MAX_CONCURRENT=5

# -------------------------------------------
# QWEN (通义千问，阿里云)
# -------------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-max
QWEN_RPM=60
QWEN_TPM=30000
QWEN_MAX_CONCURRENT=5

# -------------------------------------------
# GLM (智谱AI)
# -------------------------------------------
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GLM_MODEL=glm-4.6
GLM_RPM=60
GLM_TPM=30000
GLM_MAX_CONCURRENT=5

# -------------------------------------------
# GEMINI (Google AI)
# -------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

