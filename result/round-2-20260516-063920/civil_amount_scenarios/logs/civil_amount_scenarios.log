. capture program drop run_one_model

. program define run_one_model, rclass
  1.         syntax, MODELID(string) SCENARIO(string) [AMTVAR(name) MISSVAR(name)]
  2. 
.         local rhs "$ACT_TERM $BASE_CTRL"
  3.         if "`amtvar'" != "" {
  4.                 local rhs "`rhs' c.`amtvar' i.`missvar'"
  5.         }
  6. 
.         capture noisily logit contract_invalid `rhs', $FITOPT
  7.         if _rc capture noisily logit contract_invalid `rhs', $FITOPT technique(nr)
  8.         if _rc capture noisily logit contract_invalid `rhs', $FITOPT technique(bhhh)
  9.         if _rc {
 10.                 return scalar ok = 0
 11.                 exit
 12.         }
 13. 
.         estimates store `modelid'
 14. 
.         matrix b = e(b)
 15.         matrix V = e(V)
 16.         local cn : colnames b
 17.         local k : word count `cn'
 18.         forvalues i = 1/`k' {
 19.                 local term : word `i' of `cn'
 20.                 if regexm("`term'", "^[0-9]+\.activity_type_main_id$") {
 21.                         local dot = strpos("`term'", ".")
 22.                         local aid = real(substr("`term'", 1, `dot'-1))
 23.                         local alabel : label (activity_type_main_id) `aid'
 24. 
.                         scalar bi = b[1,`i']
 25.                         scalar sei = sqrt(V[`i',`i'])
 26.                         scalar zi = bi / sei
 27.                         scalar pi = 2*normal(-abs(zi))
 28. 
.                         post __coef ("`modelid'") ("`scenario'") (`aid') ("`alabel'") (bi) (sei) (zi) (pi)
 29.                 }
 30.         }
 31. 
.         return scalar ok = 1
 32. end

. 
. global BASE_CTRL "`base_ctrl'"

. global FITOPT "`fitopt'"

. global ACT_TERM "`act_term'"

. 
