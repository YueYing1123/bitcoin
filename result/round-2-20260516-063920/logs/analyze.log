>>> lines.append(rtf_escape(f"contract_invalid=0 (有效)：{N_VAL}") + r"\par\par")
>>> 
>>> lines.append(r"\b " + rtf_escape("2. 描述统计表") + r" \b0\par")
>>> lines.append(r"\b " + rtf_escape("2.1 按年份案件量") + r" \b0\par")
>>> lines.append(rtf_escape("年份\t案件数") + r"\par")
