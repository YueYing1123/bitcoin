. // -----------------------------
. // 3) 回归程序：单调加控制 + 交互项
. // -----------------------------
. capture program drop run_incremental_block

. program define run_incremental_block
  1.         syntax , DV(name) PREFIX(string) [SAMPLE(string)]
  2. 
.         local cond "!missing(`dv')"
  3.         if "`sample'" != "" local cond "`cond' & (`sample')"
  4. 
.         quietly count if `cond'
  5.         if r(N) < 80 {
  6.                 di as err "跳过 `prefix'：样本过小，N=" r(N)
  7.                 exit
  8.         }
  9. 
.         local cluster "$CLUSTER_USED"
 10.         local base_ctrl "i.court_level_id i.procedure_stage_id i.judgment_year i.doc_type_id i.is_appeal_b i.is_appeal_miss"
 11. 
.         local model_list ""
 12.         // esttab 会在内部给模型名加前缀 "_est_"，因此这里把内部存储名压短（<=27）
.         local pfx_short = substr("`prefix'", 1, 12)
 13.         local fitopt "vce(cluster `cluster') iterate(50)"
 14. 
.         quietly count if `cond' & is_criminal==1
 15.         local n_cr = r(N)
 16.         quietly count if `cond' & is_criminal==0
 17.         local n_cv = r(N)
 18.         local has_both_type = (`n_cr' > 0 & `n_cv' > 0)
 19. 
.         // M0: 基准模型（不含高维案由 FE）
.         capture noisily logit `dv' c.ln_amt_main i.amt_main_miss if `cond', `fitopt'
 20.         if _rc capture noisily logit `dv' c.ln_amt_main i.amt_main_miss if `cond', `fitopt' technique(nr)
 21.         if _rc capture noisily logit `dv' c.ln_amt_main i.amt_main_miss if `cond', `fitopt' technique(bhhh)
 22.         if !_rc {
 23.                 estimates store `pfx_short'_m0
 24.                 local model_list "`model_list' `pfx_short'_m0"
 25.         }
 26. 
.         // M1: 仅 activity_type
.         capture noisily logit `dv' i.activity_type_main_id if `cond', `fitopt'
 27.         if _rc capture noisily logit `dv' i.activity_type_main_id if `cond', `fitopt' technique(nr)
 28.         if _rc capture noisily logit `dv' i.activity_type_main_id if `cond', `fitopt' technique(bhhh)
 29.         if !_rc {
 30.                 estimates store `pfx_short'_m1
 31.                 local model_list "`model_list' `pfx_short'_m1"
 32.         }
 33. 
.         // M2: + 法院层级
.         capture noisily logit `dv' i.activity_type_main_id i.court_level_id if `cond', `fitopt'
 34.         if _rc capture noisily logit `dv' i.activity_type_main_id i.court_level_id if `cond', `fitopt' technique(nr)
 35.         if _rc capture noisily logit `dv' i.activity_type_main_id i.court_level_id if `cond', `fitopt' technique(bhhh)
 36.         if !_rc {
 37.                 estimates store `pfx_short'_m2
 38.                 local model_list "`model_list' `pfx_short'_m2"
 39.         }
 40. 
.         // M3: + 其余基础控制（不含金额）
.         capture noisily logit `dv' i.activity_type_main_id `base_ctrl' if `cond', `fitopt'
 41.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' if `cond', `fitopt' technique(nr)
 42.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' if `cond', `fitopt' technique(bhhh)
 43.         if !_rc {
 44.                 estimates store `pfx_short'_m3
 45.                 local model_list "`model_list' `pfx_short'_m3"
 46.         }
 47. 
.         // M4a/M4b/M4c: 依次轮询金额控制（均值/中位/最大）
.         capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_main i.amt_main_miss if `cond', `fitopt'
 48.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_main i.amt_main_miss if `cond', `fitopt' technique(nr)
 49.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_main i.amt_main_miss if `cond', `fitopt' technique(bhhh)
 50.         if !_rc {
 51.                 estimates store `pfx_short'_m4mean
 52.                 local model_list "`model_list' `pfx_short'_m4mean"
 53.         }
 54. 
.         capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_median i.amt_median_miss if `cond', `fitopt'
 55.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_median i.amt_median_miss if `cond', `fitopt' technique(nr)
 56.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_median i.amt_median_miss if `cond', `fitopt' technique(bhhh)
 57.         if !_rc {
 58.                 estimates store `pfx_short'_m4med
 59.                 local model_list "`model_list' `pfx_short'_m4med"
 60.         }
 61. 
.         capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_max i.amt_max_miss if `cond', `fitopt'
 62.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_max i.amt_max_miss if `cond', `fitopt' technique(nr)
 63.         if _rc capture noisily logit `dv' i.activity_type_main_id `base_ctrl' ///
>                 c.ln_amt_max i.amt_max_miss if `cond', `fitopt' technique(bhhh)
 64.         if !_rc {
 65.                 estimates store `pfx_short'_m4max
 66.                 local model_list "`model_list' `pfx_short'_m4max"
 67.         }
 68. 
.         // M5: 不含高维交互，仅主效应
.         if `has_both_type' {
 69.                 capture noisily logit `dv' i.activity_type_main_id i.is_criminal `base_ctrl' ///
>                         c.ln_amt_main i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt'
 70.                 if _rc capture noisily logit `dv' i.activity_type_main_id i.is_criminal `base_ctrl' ///
>                         c.ln_amt_main i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt' technique(nr)
 71.                 if _rc capture noisily logit `dv' i.activity_type_main_id i.is_criminal `base_ctrl' ///
>                         c.ln_amt_main i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt' technique(bhhh)
 72.                 if !_rc {
 73.                         estimates store `pfx_short'_m5ni
 74.                         local model_list "`model_list' `pfx_short'_m5ni"
 75.                 }
 76.         }
 77. 
.         // M6: 仅保留“刑/民 × 金额”交互（降阶，避免 i.is_criminal##i.activity_type_main_id）
.         if `has_both_type' {
 78.                 capture noisily logit `dv' i.activity_type_main_id i.is_criminal##c.ln_amt_main `base_ctrl' ///
>                         i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt'
 79.                 if _rc capture noisily logit `dv' i.activity_type_main_id i.is_criminal##c.ln_amt_main `base_ctrl' ///
>                         i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt' technique(nr)
 80.                 if _rc capture noisily logit `dv' i.activity_type_main_id i.is_criminal##c.ln_amt_main `base_ctrl' ///
>                         i.amt_main_miss if `cond' & !missing(is_criminal), `fitopt' technique(bhhh)
 81.                 if !_rc {
 82.                         estimates store `pfx_short'_m6ai
 83.                         local model_list "`model_list' `pfx_short'_m6ai"
 84.                 }
 85.         }
 86. 
.         // 导出
.         if "`model_list'" != "" {
 87.                 if $HAVE_ESTTAB == 1 {
 88.                         capture noisily esttab `model_list' using "$TABLEDIR_USED/reg_`prefix'.rtf", ///
>                                 replace rtf se star(* 0.10 ** 0.05 *** 0.01) ///
>                                 b(%9.3f) se(%9.3f) ///
>                                 mtitles("M0-base" "M1-causeOnly" "M2+court" "M3+baseCtrl" "M4-case_amount" "M4-median" "M4-max" "M5-noInter" "M6-amtInter") ///
>                                 addnotes("DV=`dv'", "cluster=`cluster'", "主金额变量=case_amount（大模型抽取）", "低频 activity_type 已合并：N<20 => 其他(稀疏)", "logit 估计设置：iterate(50)+算法回退(nr/bhhh)")
 89.                 }
 90.                 estimates save "$DATADIR_USED/reg_`prefix'.ster", replace
 91.         }
 92. end

. 
